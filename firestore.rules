rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funzione di utilità per identificare l'elenco dei campi riservati gestiti da Stripe/Server
    function hasPrivilegedFields(data) {
      return data.keys().hasAny([
        'subscriptionStatus',
        'subscriptionPlan',
        'subscriptionPeriodEnd',
        'stripeCustomerId',
        'stripeSubscriptionId'
      ]);
    }

    // Regole per il profilo utente
    match /users/{userId} {
      // 1. Lettura consentita esclusivamente al proprietario autenticato
      allow read: if request.auth != null && request.auth.uid == userId;

      // 2. Creazione consentita solo per il proprio UID, senza poter impostare campi di abbonamento privilegiati
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && !hasPrivilegedFields(request.resource.data);

      // 3. Modifica consentita solo per il proprio UID:
      //    l'utente non può alterare nessuno dei campi privilegiati (la differenza non deve includerli)
      allow update: if request.auth != null 
                    && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'subscriptionStatus',
                      'subscriptionPlan',
                      'subscriptionPeriodEnd',
                      'stripeCustomerId',
                      'stripeSubscriptionId'
                    ]);

      // 4. Eliminazione consentita esclusivamente al proprietario
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Registrazioni audio demo ufficiali degli esercizi di canto:
    // Lettura pubblica: consente a tutti gli allievi di ascoltare gli esempi vocali ufficiali
    // Scrittura: consentita esclusivamente all'account Coach autorizzato
    match /demo_audio_recordings/{demoKey} {
      allow read: if true;
      allow write: if request.auth != null && 
                   (request.auth.token.email == 'francesca.atzei0@gmail.com' ||
                    request.auth.uid == 'francesca.atzei0@gmail.com');
    }
  }
}
